@inject Microsoft.AspNetCore.Identity.UserManager<Uni_Selector.Models.ApplicationUser> UserManager

@if (User.Identity?.IsAuthenticated == true)
{
    var userId = UserManager.GetUserId(User);

    <!-- Notification Toast Container -->
    <div id="notification-toast-container"></div>

    <!-- Connection Status Indicator -->
    <div id="connection-status"></div>

    <!-- Notification Dropdown in Navbar -->
    <div class="notification-dropdown">
        <button class="notification-dropdown-toggle" id="notification-toggle">
            <i class="fas fa-bell"></i>
            <span class="notification-badge" style="display: none;">0</span>
        </button>

        <div class="notification-dropdown-menu" id="notification-dropdown">
            <div class="notification-dropdown-header">
                <h3>Notifications</h3>
                <div class="notification-dropdown-actions">
                    <button class="btn btn-sm btn-link" id="mark-all-read-btn" title="Mark all as read">
                        <i class="fas fa-check-double"></i>
                    </button>
                    <button class="btn btn-sm btn-link" id="refresh-notifications-btn" title="Refresh">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
            </div>
            <div class="notification-dropdown-body">
                <div id="recent-notifications-container">
                    <div class="no-notifications">Loading notifications...</div>
                </div>
            </div>
            <div class="notification-dropdown-footer">
                <a href="/Notifications">View All Notifications</a>
            </div>
        </div>
    </div>

    <!-- Notification Sound (Optional) -->
    <audio id="notification-sound" preload="auto">
        <source src="/sounds/notification.mp3" type="audio/mpeg">
        <source src="/sounds/notification.ogg" type="audio/ogg">
    </audio>

    <!-- SignalR Script -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@latest/dist/browser/signalr.min.js"></script>
    <link rel="stylesheet" href="~/css/notifications.css" />
    <script src="~/js/signalr-notification.js"></script>

    <!-- Dropdown Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggle = document.getElementById('notification-toggle');
            const dropdown = document.getElementById('notification-dropdown');

            if (toggle && dropdown) {
                toggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    dropdown.classList.toggle('show');

                    if (dropdown.classList.contains('show')) {
                        window.notificationManager?.getRecentNotifications(10);
                    }
                });

                document.addEventListener('click', function() {
                    dropdown.classList.remove('show');
                });

                dropdown.addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            }
        });
    </script>

    <!-- Add user authenticated attribute to body -->
    <script>
        document.body.setAttribute('data-user-authenticated', 'true');
        @if (User.IsInRole("UniversityRep"))
        {
                var universityRep = await UserManager.GetUserAsync(User);
                // Get university ID from database and set it
                <text>
                // document.body.setAttribute('data-university-id', '@universityId');
                </text>
        }
    </script>
}
