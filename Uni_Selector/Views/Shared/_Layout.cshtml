    <script>
        // Enhanced Dropdown Toggle Functions with Accessibility
        function toggleNotifications() {
            const dropdown = document.getElementById('notificationDropdown');
            const userMenu = document.getElementById('userMenuDropdown');
            const button = document.querySelector('.notification-trigger');
            
            const isShowing = dropdown.classList.contains('show');
            dropdown.classList.toggle('show');
            userMenu.classList.remove('show');
            
            // Update ARIA attributes
            button.setAttribute('aria-expanded', !isShowing);
            
            if (!isShowing) {
                // Mark notifications as read when dropdown is opened
                setTimeout(() => markNotificationsAsRead(), 1000);
            }
        }

        function toggleUserMenu() {
            const dropdown = document.getElementById('userMenuDropdown');
            const notificationMenu = document.getElementById('notificationDropdown');
            const button = document.querySelector('button[onclick="toggleUserMenu()"]');
            
            const isShowing = dropdown.classList.contains('show');
            dropdown.classList.toggle('show');
            notificationMenu.classList.remove('show');
            
            // Update ARIA attributes
            button.setAttribute('aria-expanded', !isShowing);
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(event) {
            const notificationDropdown = document.getElementById('notificationDropdown');
            const userMenuDropdown = document.getElementById('userMenuDropdown');
            
            if (!event.target.closest('.notification-trigger') && !event.target.closest('#notificationDropdown')) {
                notificationDropdown.classList.remove('show');
                document.querySelector('.notification-trigger')?.setAttribute('aria-expanded', 'false');
            }
            if (!event.target.closest('button[onclick="toggleUserMenu()"]') && !event.target.closest('#userMenuDropdown')) {
                userMenuDropdown.classList.remove('show');
                document.querySelector('button[onclick="toggleUserMenu()"]')?.setAttribute('aria-expanded', 'false');
            }
        });

        // Close dropdowns on Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                document.getElementById('notificationDropdown').classList.remove('show');
                document.getElementById('userMenuDropdown').classList.remove('show');
                document.querySelector('.notification-trigger')?.setAttribute('aria-expanded', 'false');
                document.querySelector('button[onclick="toggleUserMenu()"]')?.setAttribute('aria-expanded', 'false');
            }
        });

        // Mark notifications as read
        function markNotificationsAsRead() {
            fetch('/api/notification/mark-all-read', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
                }
            }).catch(err => console.error('Error marking notifications as read:', err));
        }
    </script>

    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            // Enhanced SignalR Notification Hub Connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000]) // Retry intervals
                .configureLogging(signalR.LogLevel.Information)
                .build();

            // Connection state management
            const connectionStatus = document.getElementById('connectionStatus');
            const connectionStatusText = document.getElementById('connectionStatusText');

            connection.on("ReceiveNotification", function (notification) {
                updateNotificationBadge();
                showEnhancedNotificationToast(notification);
                loadRecentNotifications();
            });

            connection.on("UnreadCountUpdated", function (count) {
                updateBadgeCount(count);
            });

            // Connection lifecycle events
            connection.onclose(() => {
                console.log("SignalR Disconnected");
                showConnectionStatus('Disconnected', false);
            });

            connection.onreconnecting(() => {
                console.log("SignalR Reconnecting...");
                showConnectionStatus('Reconnecting...', false);
            });

            connection.onreconnected(() => {
                console.log("SignalR Reconnected");
                showConnectionStatus('Connected', true);
                updateNotificationBadge();
                loadRecentNotifications();
            });

            // Start connection
            async function startConnection() {
                try {
                    await connection.start();
                    console.log("SignalR Connected");
                    showConnectionStatus('Connected', true);
                    updateNotificationBadge();
                    loadRecentNotifications();
                } catch (err) {
                    console.error("SignalR Connection Error: ", err);
                    showConnectionStatus('Connection Failed', false);
                    // Retry after 5 seconds
                    setTimeout(startConnection, 5000);
                }
            }

            startConnection();

            function showConnectionStatus(text, isConnected) {
                connectionStatusText.textContent = text;
                connectionStatus.classList.toggle('disconnected', !isConnected);
                connectionStatus.classList.add('show');
                
                if (isConnected) {
                    setTimeout(() => {
                        connectionStatus.classList.remove('show');
                    }, 3000);
                }
            }

            function updateBadgeCount(count) {
                const badge = document.getElementById('notificationCount');
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.style.display = 'inline-block';
                    badge.classList.add('notification-badge');
                } else {
                    badge.style.display = 'none';
                }
            }

            function updateNotificationBadge() {
                fetch('/api/notification/unread-count')
                    .then(response => response.json())
                    .then(data => updateBadgeCount(data.count))
                    .catch(err => console.error('Error fetching notification count:', err));
            }

            function showEnhancedNotificationToast(notification) {
                const toast = document.createElement('div');
                toast.className = 'notification-toast';
                toast.innerHTML = `
                    <div class="notification-toast-header">
                        <div class="notification-toast-icon">
                            <i class="icofont-bell"></i>
                        </div>
                        <button class="notification-toast-close" onclick="this.closest('.notification-toast').remove()" aria-label="Close notification">
                            ×
                        </button>
                    </div>
                    <div class="notification-toast-content">
                        <strong>${escapeHtml(notification.title || 'Notification')}</strong>
                        <p>${escapeHtml(notification.message || '')}</p>
                    </div>
                    <div class="notification-toast-progress"></div>
                `;
                document.body.appendChild(toast);

                // Show toast
                setTimeout(() => toast.classList.add('show'), 100);

                // Auto-hide after 5 seconds
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 400);
                }, 5000);

                // Play notification sound (optional)
                playNotificationSound();
            }

            function loadRecentNotifications() {
                const list = document.getElementById('notificationList');
                list.innerHTML = '<div class="dropdown-loading"></div>';

                fetch('/api/notification/recent?count=5')
                    .then(response => response.json())
                    .then(data => {
                        if (data.notifications && data.notifications.length > 0) {
                            list.innerHTML = data.notifications.map(n => `
                                <li role="none">
                                    <a href="${escapeHtml(n.actionUrl || '#')}" 
                                       role="menuitem"
                                       class="${n.isRead ? '' : 'unread'}"
                                       ${n.isRead ? '' : 'style="padding-left:24px;"'}>
                                        <strong>${escapeHtml(n.title)}</strong>
                                        <span style="display:block;font-size:12px;color:#64748b;margin-top:2px;">${escapeHtml(n.message)}</span>
                                        <small>${formatDate(n.createdAt)}</small>
                                    </a>
                                </li>
                            `).join('');
                        } else {
                            list.innerHTML = `
                                <div class="empty-notifications">
                                    <i class="icofont-bell"></i>
                                    <p>No new notifications</p>
                                </div>
                            `;
                        }
                    })
                    .catch(err => {
                        console.error('Error loading notifications:', err);
                        list.innerHTML = `
                            <div class="empty-notifications">
                                <i class="icofont-warning"></i>
                                <p style="color:#ef4444;">Error loading notifications</p>
                            </div>
                        `;
                    });
            }

            function formatDate(dateString) {
                const date = new Date(dateString);
                const now = new Date();
                const diff = Math.floor((now - date) / 1000);

                if (diff < 60) return 'Just now';
                if (diff < 3600) return Math.floor(diff / 60) + ' min ago';
                if (diff < 86400) return Math.floor(diff / 3600) + ' hr ago';
                if (diff < 604800) return Math.floor(diff / 86400) + ' days ago';
                return date.toLocaleDateString();
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function playNotificationSound() {
                // Optional: Add notification sound
                // const audio = new Audio('/assets/sounds/notification.mp3');
                // audio.play().catch(() => {});
            }

            // Load notifications on page load
            document.addEventListener('DOMContentLoaded', function() {
                loadRecentNotifications();
            });

            // Refresh notifications every 30 seconds
            setInterval(updateNotificationBadge, 30000);
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
