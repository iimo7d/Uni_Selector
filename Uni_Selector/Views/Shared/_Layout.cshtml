                                            </a>
                                        </li>
                                        <li class="nav-item" role="none">
                                            <a asp-controller="Student" asp-action="Recommendations" role="menuitem" class="px-5 lg:px-10px 2xl:px-15px 3xl:px-5 py-10 lg:py-5 2xl:py-30px 3xl:py-10 leading-sm 2xl:leading-lg text-base lg:text-sm 2xl:text-base font-semibold block hover:text-primaryColor dark:text-whiteColor">
                                                <i class="icofont-star mr-1" aria-hidden="true"></i> Recommendations
                                            </a>
                                        </li>
                                        <li class="nav-item" role="none">
                                            <a asp-controller="Student" asp-action="Applications" role="menuitem" class="px-5 lg:px-10px 2xl:px-15px 3xl:px-5 py-10 lg:py-5 2xl:py-30px 3xl:py-10 leading-sm 2xl:leading-lg text-base lg:text-sm 2xl:text-base font-semibold block hover:text-primaryColor dark:text-whiteColor">
                                                <i class="icofont-paper mr-1" aria-hidden="true"></i> My Applications
                                            </a>
                                        </li>
                                        <li class="nav-item" role="none">
                                            <a asp-controller="Discounts" asp-action="Index" role="menuitem" class="px-5 lg:px-10px 2xl:px-15px 3xl:px-5 py-10 lg:py-5 2xl:py-30px 3xl:py-10 leading-sm 2xl:leading-lg text-base lg:text-sm 2xl:text-base font-semibold block hover:text-primaryColor dark:text-whiteColor">
                                                <i class="icofont-tags mr-1" aria-hidden="true"></i> Discounts
                                            </a>
                                        </li>
                                    }

                                    <!-- University Representative Links -->
                                    @if (User.IsInRole("UniversityRep"))
                                    {
                                        <li class="nav-item" role="none">
                                            <a asp-controller="UniversityRep" asp-action="Dashboard" role="menuitem" class="px-5 lg:px-10px 2xl:px-15px 3xl:px-5 py-10 lg:py-5 2xl:py-30px 3xl:py-10 leading-sm 2xl:leading-lg text-base lg:text-sm 2xl:text-base font-semibold block hover:text-primaryColor dark:text-whiteColor">
                                                <i class="icofont-dashboard-web mr-1" aria-hidden="true"></i> Dashboard
                                            </a>
                                        </li>
                                        <li class="nav-item" role="none">
                                            <a asp-controller="UniversityRep" asp-action="Programs" role="menuitem" class="px-5 lg:px-10px 2xl:px-15px 3xl:px-5 py-10 lg:py-5 2xl:py-30px 3xl:py-10 leading-sm 2xl:leading-lg text-base lg:text-sm 2xl:text-base font-semibold block hover:text-primaryColor dark:text-whiteColor">
                                                <i class="icofont-graduate mr-1" aria-hidden="true"></i> Programs
                                            </a>
                                        </li>
                                        <li class="nav-item" role="none">
                                            <a asp-controller="UniversityRep" asp-action="Applications" role="menuitem" class="px-5 lg:px-10px 2xl:px-15px 3xl:px-5 py-10 lg:py-5 2xl:py-30px 3xl:py-10 leading-sm 2xl:leading-lg text-base lg:text-sm 2xl:text-base font-semibold block hover:text-primaryColor dark:text-whiteColor">
                                                <i class="icofont-tasks mr-1" aria-hidden="true"></i> Applications
                                            </a>
                                        </li>
                                    }

                                    <!-- BTEC Authority Links -->
                                    @if (User.IsInRole("BtecAuthority"))
                                    {
                                        <li class="nav-item" role="none">
                                            <a asp-controller="BTECAuthority" asp-action="Dashboard" role="menuitem" class="px-5 lg:px-10px 2xl:px-15px 3xl:px-5 py-10 lg:py-5 2xl:py-30px 3xl:py-10 leading-sm 2xl:leading-lg text-base lg:text-sm 2xl:text-base font-semibold block hover:text-primaryColor dark:text-whiteColor">
                                                <i class="icofont-dashboard-web mr-1" aria-hidden="true"></i> BTEC Dashboard
                                            </a>
                                        </li>
                                        <li class="nav-item" role="none">
                                            <a asp-controller="BTECAuthority" asp-action="Programs" role="menuitem" class="px-5 lg:px-10px 2xl:px-15px 3xl:px-5 py-10 lg:py-5 2xl:py-30px 3xl:py-10 leading-sm 2xl:leading-lg text-base lg:text-sm 2xl:text-base font-semibold block hover:text-primaryColor dark:text-whiteColor">
                                                <i class="icofont-verification-check mr-1" aria-hidden="true"></i> BTEC Programs
                                            </a>
