@*
    Uni Selector - Admin Sidebar (clean)
    Template pages removed, only your controllers/endpoints kept
*@

<aside class="sidebar">
    <button type="button" class="sidebar-close-btn">
        <iconify-icon icon="radix-icons:cross-2"></iconify-icon>
    </button>

    <div>
        <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-logo">
            <img src="~/assets/images/logo/logo_1.png" alt="site logo" class="light-logo">
            <img src="~/adminAssets/images/logo-light.png" alt="site logo" class="dark-logo">
            <img src="~/assets/images/logo/logo_1.png" alt="site logo" class="logo-icon">
        </a>
    </div>

    <div class="sidebar-menu-area">
        <ul class="sidebar-menu" id="sidebar-menu">

            <!-- Dashboard -->
            <li>
                <a href="@Url.Action("Dashboard", "Admin")">
                    <iconify-icon icon="solar:home-smile-angle-outline" class="menu-icon"></iconify-icon>
                    <span>Dashboard</span>
                </a>
            </li>

            <li>
                <a href="@Url.Action("SystemHealth", "Admin")">
                    <iconify-icon icon="solar:shield-check-outline" class="menu-icon"></iconify-icon>
                    <span>System Health</span>
                </a>
            </li>

            <li class="sidebar-menu-group-title">Management</li>

            <!-- Applications -->
            <li class="dropdown">
                <a href="javascript:void(0)">
                    <iconify-icon icon="hugeicons:invoice-03" class="menu-icon"></iconify-icon>
                    <span>Applications</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a href="@Url.Action("Index", "ApplicationAdmin")">
                            <i class="ri-circle-fill circle-icon text-primary-600 w-auto"></i> All Applications
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Statistics", "ApplicationAdmin")">
                            <i class="ri-circle-fill circle-icon text-warning-main w-auto"></i> Statistics
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Export", "ApplicationAdmin")">
                            <i class="ri-circle-fill circle-icon text-success-main w-auto"></i> Export
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Programs -->
            <li class="dropdown">
                <a href="javascript:void(0)">
                    <iconify-icon icon="solar:document-text-outline" class="menu-icon"></iconify-icon>
                    <span>Programs</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a href="@Url.Action("Index", "ProgramAdmin")">
                            <i class="ri-circle-fill circle-icon text-primary-600 w-auto"></i> Programs List
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Create", "ProgramAdmin")">
                            <i class="ri-circle-fill circle-icon text-info-main w-auto"></i> Add Program
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Import", "ProgramAdmin")">
                            <i class="ri-circle-fill circle-icon text-warning-main w-auto"></i> Import Programs
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Universities -->
            <li class="dropdown">
                <a href="javascript:void(0)">
                    <iconify-icon icon="mingcute:building-4-line" class="menu-icon"></iconify-icon>
                    <span>Universities</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a href="@Url.Action("Index", "UniversityAdmin")">
                            <i class="ri-circle-fill circle-icon text-primary-600 w-auto"></i> Universities List
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Create", "UniversityAdmin")">
                            <i class="ri-circle-fill circle-icon text-info-main w-auto"></i> Add University
                        </a>
                    </li>

                </ul>
            </li>

            <!-- Users -->
            <li class="dropdown">
                <a href="javascript:void(0)">
                    <iconify-icon icon="flowbite:users-group-outline" class="menu-icon"></iconify-icon>
                    <span>Users</span>
                </a>
                <ul class="sidebar-submenu">
                    <li>
                        <a href="@Url.Action("Index", "UserManagement")">
                            <i class="ri-circle-fill circle-icon text-primary-600 w-auto"></i> Users List
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Create", "UserManagement")">
                            <i class="ri-circle-fill circle-icon text-info-main w-auto"></i> Add User
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Export", "UserManagement")">
                            <i class="ri-circle-fill circle-icon text-success-main w-auto"></i> Export Users
                        </a>
                    </li>
                </ul>
            </li>

        </ul>
    </div>
</aside>
