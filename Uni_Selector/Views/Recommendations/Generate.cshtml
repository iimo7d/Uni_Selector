@using Uni_Selector.ViewModels.Recommendations
@model GenerateRecommendationsViewModel

@{
    ViewData["Title"] = "Generate Recommendations";
}

<!-- Breadcrumb -->
<section class="bg-whiteColor dark:bg-whiteColor-dark py-30px">
    <div class="container 3xl:container-secondary-lg 4xl:container mx-auto">
        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-bold text-blackColor dark:text-blackColor-dark">
                Generate Recommendations
            </h2>
            <ul class="flex gap-1 text-sm text-contentColor dark:text-contentColor-dark">
                <li><a asp-controller="Dashboard" asp-action="Index" class="hover:text-primaryColor">Dashboard</a></li>
                <li>/</li>
                <li><a asp-action="Index" class="hover:text-primaryColor">Recommendations</a></li>
                <li>/</li>
                <li>Generate</li>
            </ul>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="py-50px">
    <div class="container 3xl:container-secondary-lg 4xl:container mx-auto">
        <div class="max-w-4xl mx-auto">

            <!-- Hero Section -->
            <div class="text-center mb-12">
                <div class="inline-block p-5 bg-primaryColor bg-opacity-10 rounded-full mb-6">
                    <i class="icofont-brain-alt text-6xl text-primaryColor"></i>
                </div>
                <h1 class="text-3xl md:text-4xl font-bold text-blackColor dark:text-blackColor-dark mb-4">
                    AI-Powered University Recommendations
                </h1>
                <p class="text-lg text-contentColor dark:text-contentColor-dark max-w-2xl mx-auto">
                    Our intelligent system will analyze your profile and generate personalized university program recommendations tailored to your academic background, preferences, and goals.
                </p>
            </div>

            <!-- Status Card -->
            @if (Model.HasExistingRecommendations)
            {
                <div class="bg-blue-50 dark:bg-blue-900 border border-blue-200 dark:border-blue-700 rounded-lg p-6 mb-8">
                    <div class="flex items-start">
                        <i class="icofont-info-circle text-3xl text-blue-600 mr-4 mt-1"></i>
                        <div>
                            <h3 class="text-lg font-bold text-blackColor dark:text-blackColor-dark mb-2">
                                You Have Existing Recommendations
                            </h3>
                            <p class="text-sm text-contentColor dark:text-contentColor-dark mb-3">
                                You currently have <strong>@Model.ExistingRecommendationsCount recommendations</strong> in your profile.
                                Generating new recommendations will replace your existing ones.
                            </p>
                            <a asp-action="Index" class="text-primaryColor hover:text-secondaryColor font-semibold text-sm">
                                <i class="icofont-eye"></i> View Current Recommendations
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- How It Works -->
            <div class="bg-whiteColor dark:bg-whiteColor-dark shadow-md rounded-lg p-8 mb-8">
                <h3 class="text-2xl font-bold text-blackColor dark:text-blackColor-dark mb-6 text-center">
                    How Our Recommendation System Works
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <!-- Factor 1 -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 bg-primaryColor bg-opacity-10 rounded-lg flex items-center justify-center mr-4">
                            <i class="icofont-graduate text-2xl text-primaryColor"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-blackColor dark:text-blackColor-dark mb-2">Academic Profile</h4>
                            <p class="text-sm text-contentColor dark:text-contentColor-dark">
                                Your GPA, educational path, and academic track are matched with program entry requirements.
                            </p>
                        </div>
                    </div>

                    <!-- Factor 2 -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 bg-secondaryColor bg-opacity-10 rounded-lg flex items-center justify-center mr-4">
                            <i class="icofont-wallet text-2xl text-secondaryColor"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-blackColor dark:text-blackColor-dark mb-2">Budget Compatibility</h4>
                            <p class="text-sm text-contentColor dark:text-contentColor-dark">
                                Programs are matched to your registration budget, with the 5% platform discount applied.
                            </p>
                        </div>
                    </div>

                    <!-- Factor 3 -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 bg-green-500 bg-opacity-10 rounded-lg flex items-center justify-center mr-4">
                            <i class="icofont-location-pin text-2xl text-green-600"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-blackColor dark:text-blackColor-dark mb-2">Location Preferences</h4>
                            <p class="text-sm text-contentColor dark:text-contentColor-dark">
                                Distance from your city and preferred university locations are factored into recommendations.
                            </p>
                        </div>
                    </div>

                    <!-- Factor 4 -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 bg-purple-500 bg-opacity-10 rounded-lg flex items-center justify-center mr-4">
                            <i class="icofont-heart text-2xl text-purple-600"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-blackColor dark:text-blackColor-dark mb-2">Major Interests</h4>
                            <p class="text-sm text-contentColor dark:text-contentColor-dark">
                                Your desired majors are matched with available programs to find the best fit.
                            </p>
                        </div>
                    </div>

                    <!-- Factor 5 -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 bg-orange-500 bg-opacity-10 rounded-lg flex items-center justify-center mr-4">
                            <i class="icofont-language text-2xl text-orange-600"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-blackColor dark:text-blackColor-dark mb-2">Language Preference</h4>
                            <p class="text-sm text-contentColor dark:text-contentColor-dark">
                                Programs taught in your preferred language receive higher priority in recommendations.
                            </p>
                        </div>
                    </div>

                    <!-- Factor 6 -->
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-12 h-12 bg-yellow-500 bg-opacity-10 rounded-lg flex items-center justify-center mr-4">
                            <i class="icofont-star text-2xl text-yellow-600"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-blackColor dark:text-blackColor-dark mb-2">Special Circumstances</h4>
                            <p class="text-sm text-contentColor dark:text-contentColor-dark">
                                Family connections, scholarships, and special needs are considered for bonus points.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Scoring Information -->
                <div class="bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900 dark:to-purple-900 rounded-lg p-6">
                    <h4 class="font-bold text-blackColor dark:text-blackColor-dark mb-3 flex items-center">
                        <i class="icofont-chart-histogram text-primaryColor mr-2"></i>
                        Match Score Breakdown
                    </h4>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
                        <div>
                            <div class="flex items-center mb-1">
                                <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
                                <span class="font-semibold">80-100%</span>
                            </div>
                            <p class="text-contentColor dark:text-contentColor-dark">Excellent Match</p>
                        </div>
                        <div>
                            <div class="flex items-center mb-1">
                                <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
                                <span class="font-semibold">60-79%</span>
                            </div>
                            <p class="text-contentColor dark:text-contentColor-dark">Good Match</p>
                        </div>
                        <div>
                            <div class="flex items-center mb-1">
                                <div class="w-3 h-3 bg-yellow-500 rounded-full mr-2"></div>
                                <span class="font-semibold">40-59%</span>
                            </div>
                            <p class="text-contentColor dark:text-contentColor-dark">Fair Match</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Generate Form -->
            <form asp-action="Generate" method="post" id="generateForm" class="bg-whiteColor dark:bg-whiteColor-dark shadow-md rounded-lg p-8">
                @Html.AntiForgeryToken()

                <div class="text-center mb-6">
                    <h3 class="text-2xl font-bold text-blackColor dark:text-blackColor-dark mb-3">
                        Ready to Get Your Recommendations?
                    </h3>
                    <p class="text-contentColor dark:text-contentColor-dark">
                        Click the button below to generate personalized university recommendations based on your profile.
                    </p>
                </div>

                @if (Model.HasExistingRecommendations)
                {
                    <div class="bg-yellow-50 dark:bg-yellow-900 border border-yellow-200 dark:border-yellow-700 rounded-lg p-4 mb-6">
                        <div class="flex items-center">
                            <i class="icofont-warning text-2xl text-yellow-600 mr-3"></i>
                            <p class="text-sm text-contentColor dark:text-contentColor-dark">
                                <strong>Note:</strong> Generating new recommendations will replace your current @Model.ExistingRecommendationsCount recommendations.
                                This action cannot be undone.
                            </p>
                        </div>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="flex flex-col md:flex-row gap-4 justify-center">
                    <button type="submit" class="px-10 py-4 bg-primaryColor text-white text-lg font-semibold rounded-lg hover:bg-opacity-90 transition shadow-lg">
                        <i class="icofont-refresh"></i> Generate Recommendations Now
                    </button>
                    <a asp-action="Index" class="px-10 py-4 bg-gray-300 text-gray-700 text-lg font-semibold rounded-lg hover:bg-gray-400 transition text-center">
                        <i class="icofont-arrow-left"></i> Back to Recommendations
                    </a>
                </div>

                <!-- Tips Section -->
                <div class="mt-8 pt-6 border-t border-borderColor dark:border-borderColor-dark">
                    <h4 class="font-bold text-blackColor dark:text-blackColor-dark mb-3 flex items-center">
                        <i class="icofont-bulb-alt text-yellow-500 mr-2"></i>
                        Tips for Better Recommendations
                    </h4>
                    <ul class="space-y-2 text-sm text-contentColor dark:text-contentColor-dark">
                        <li class="flex items-start">
                            <i class="icofont-check text-green-600 mr-2 mt-1"></i>
                            <span>Make sure your profile is complete and up-to-date before generating recommendations.</span>
                        </li>
                        <li class="flex items-start">
                            <i class="icofont-check text-green-600 mr-2 mt-1"></i>
                            <span>Include multiple desired majors to get a wider range of program suggestions.</span>
                        </li>
                        <li class="flex items-start">
                            <i class="icofont-check text-green-600 mr-2 mt-1"></i>
                            <span>Be realistic with your budget to ensure recommendations match your financial capacity.</span>
                        </li>
                        <li class="flex items-start">
                            <i class="icofont-check text-green-600 mr-2 mt-1"></i>
                            <span>You can regenerate recommendations anytime if your preferences change.</span>
                        </li>
                    </ul>
                </div>
            </form>

            <!-- Need Help -->
            <div class="text-center mt-8">
                <p class="text-sm text-contentColor dark:text-contentColor-dark mb-3">
                    Need to update your profile before generating recommendations?
                </p>
                <a asp-controller="Student" asp-action="Edit" class="text-primaryColor hover:text-secondaryColor font-semibold">
                    <i class="icofont-edit"></i> Edit Your Profile
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $('#generateForm').submit(function(e) {
            e.preventDefault();

            @if (Model.HasExistingRecommendations)
            {
                    <text>
                    Swal.fire({
                        title: 'Replace Existing Recommendations?',
                        html: '<p>You currently have <strong>@Model.ExistingRecommendationsCount recommendations</strong>.</p><p class="mt-2">Generating new recommendations will replace them. This action cannot be undone.</p>',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: '<i class="icofont-refresh"></i> Yes, Generate New!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            showLoadingAndSubmit();
                        }
                    });
                    </text>
            }
            else
            {
                    <text>
                    Swal.fire({
                        title: 'Generate Recommendations?',
                        text: "The system will analyze your profile and create personalized university recommendations.",
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: '<i class="icofont-check"></i> Yes, Generate!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            showLoadingAndSubmit();
                        }
                    });
                    </text>
            }
        });

        function showLoadingAndSubmit() {
            Swal.fire({
                title: 'Generating Recommendations...',
                html: '<p class="mb-3">Please wait while our AI analyzes your profile and generates personalized recommendations.</p><div class="flex justify-center"><div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primaryColor"></div></div>',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            document.getElementById('generateForm').submit();
        }
    </script>
}
