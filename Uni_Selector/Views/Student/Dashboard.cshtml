@using Uni_Selector.ViewModels.Student
@model StudentDashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم الطالب";
}

<!-- Banner Section -->
<section>
    <div class="container-fluid-2">
        <div class="bg-primaryColor p-5 md:p-10 rounded-5 flex justify-center md:justify-between items-center flex-wrap gap-2">
            <div class="flex items-center flex-wrap justify-center sm:justify-start">
                <div class="mr-5">
                    <div class="w-27 h-27 md:w-22 md:h-22 lg:w-27 lg:h-27 rounded-full p-1 border-2 border-white box-content bg-white/20 flex items-center justify-center">
                        <i class="icofont-user-alt-3 text-4xl text-white"></i>
                    </div>
                </div>
                <div class="text-whiteColor font-bold text-center sm:text-start">
                    <h5 class="text-2xl leading-1.24 mb-5px">مرحباً، @Model.FullName</h5>
                    <ul class="flex items-center gap-15px flex-wrap">
                        <li class="text-sm font-normal flex items-center gap-0.5">
                            <i class="icofont-location-pin"></i>
                            @Model.Province - @Model.City
                        </li>
                        <li class="text-sm font-normal flex items-center gap-0.5">
                            <i class="icofont-graduate"></i>
                            @Model.PathDisplay @(Model.TrackDisplay != null ? $"- {Model.TrackDisplay}" : "")
                        </li>
                        <li class="text-sm font-normal flex items-center gap-0.5">
                            <i class="icofont-chart-bar-graph"></i>
                            المعدل: @Model.GPA%
                        </li>
                    </ul>
                </div>
            </div>

            <div class="flex gap-3">
                @if (!Model.IsProfileComplete)
                {
                    <a asp-action="CompleteProfile" class="text-size-15 text-primaryColor bg-whiteColor px-25px py-10px border border-whiteColor hover:bg-transparent hover:text-whiteColor rounded group text-nowrap flex gap-1 items-center">
                        أكمل ملفك الشخصي
                        <i class="icofont-arrow-left"></i>
                    </a>
                }
                <a asp-controller="Recommendations" asp-action="Generate" class="text-size-15 text-whiteColor bg-secondaryColor px-25px py-10px border border-secondaryColor hover:text-secondaryColor hover:bg-whiteColor rounded group text-nowrap flex gap-1 items-center">
                    احصل على توصيات
                    <i class="icofont-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Dashboard Content Section -->
<section>
    <div class="container-fluid-2">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-30px pt-30px pb-100px">

            <!-- Sidebar Navigation -->
            <div class="lg:col-start-1 lg:col-span-3">
                @await Html.PartialAsync("_StudentSidebar", "Dashboard")
            </div>

            <!-- Main Content -->
            <div class="lg:col-start-4 lg:col-span-9">

                <!-- Profile Incomplete Alert -->
                @if (!Model.IsProfileComplete)
                {
                    <div class="bg-warning/10 border border-warning text-warning p-4 rounded-lg mb-6 flex items-center gap-3">
                        <i class="icofont-warning text-2xl"></i>
                        <div>
                            <h6 class="font-bold">ملفك الشخصي غير مكتمل</h6>
                            <p class="text-sm">أكمل بياناتك الشخصية للحصول على توصيات دقيقة للجامعات والبرامج المناسبة لك.</p>
                        </div>
                        <a asp-action="CompleteProfile" class="btn-primary-sm mr-auto">أكمل الآن</a>
                    </div>
                }

                <!-- Statistics Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-30px mb-30px">
                    <!-- Recommendations Card -->
                    <div class="p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg">
                        <div class="flex items-center gap-4">
                            <div class="w-60px h-60px rounded-full bg-primaryColor/10 flex items-center justify-center">
                                <i class="icofont-light-bulb text-2xl text-primaryColor"></i>
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-blackColor dark:text-blackColor-dark">@Model.TotalRecommendations</h3>
                                <p class="text-contentColor dark:text-contentColor-dark text-sm">التوصيات</p>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-borderColor dark:border-borderColor-dark">
                            <span class="text-sm text-contentColor dark:text-contentColor-dark">
                                <span class="text-greenColor">@Model.ViewedRecommendations</span> مشاهدة
                            </span>
                        </div>
                    </div>

                    <!-- Applications Card -->
                    <div class="p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg">
                        <div class="flex items-center gap-4">
                            <div class="w-60px h-60px rounded-full bg-secondaryColor/10 flex items-center justify-center">
                                <i class="icofont-file-document text-2xl text-secondaryColor"></i>
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-blackColor dark:text-blackColor-dark">@Model.TotalApplications</h3>
                                <p class="text-contentColor dark:text-contentColor-dark text-sm">الطلبات</p>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-borderColor dark:border-borderColor-dark">
                            <span class="text-sm text-contentColor dark:text-contentColor-dark">
                                <span class="text-warning">@Model.PendingApplications</span> قيد الانتظار
                            </span>
                        </div>
                    </div>

                    <!-- Approved Card -->
                    <div class="p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg">
                        <div class="flex items-center gap-4">
                            <div class="w-60px h-60px rounded-full bg-greenColor/10 flex items-center justify-center">
                                <i class="icofont-check-circled text-2xl text-greenColor"></i>
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-blackColor dark:text-blackColor-dark">@Model.ApprovedApplications</h3>
                                <p class="text-contentColor dark:text-contentColor-dark text-sm">مقبولة</p>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-borderColor dark:border-borderColor-dark">
                            <span class="text-sm text-greenColor">
                                <i class="icofont-check"></i> طلبات موافق عليها
                            </span>
                        </div>
                    </div>

                    <!-- Discounts Card -->
                    <div class="p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg">
                        <div class="flex items-center gap-4">
                            <div class="w-60px h-60px rounded-full bg-purple/10 flex items-center justify-center">
                                <i class="icofont-ticket text-2xl text-purple"></i>
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-blackColor dark:text-blackColor-dark">@Model.ActiveDiscounts</h3>
                                <p class="text-contentColor dark:text-contentColor-dark text-sm">خصومات نشطة</p>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-borderColor dark:border-borderColor-dark">
                            <a asp-controller="Discounts" asp-action="Index" class="text-sm text-primaryColor hover:text-secondaryColor">
                                عرض الكل <i class="icofont-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Recent Recommendations -->
                <div class="p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg mb-30px">
                    <div class="flex justify-between items-center mb-6 pb-5 border-b-2 border-borderColor dark:border-borderColor-dark">
                        <h2 class="text-xl font-bold text-blackColor dark:text-blackColor-dark">
                            <i class="icofont-light-bulb text-primaryColor ml-2"></i>
                            أحدث التوصيات
                        </h2>
                        <a asp-controller="Recommendations" asp-action="Index" class="text-primaryColor hover:text-secondaryColor text-sm">
                            عرض الكل <i class="icofont-arrow-left"></i>
                        </a>
                    </div>

                    @if (Model.RecentRecommendations.Any())
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="bg-lightGrey5 dark:bg-whiteColor-dark">
                                        <th class="p-4 text-right font-semibold text-blackColor dark:text-blackColor-dark">البرنامج</th>
                                        <th class="p-4 text-right font-semibold text-blackColor dark:text-blackColor-dark">الجامعة</th>
                                        <th class="p-4 text-center font-semibold text-blackColor dark:text-blackColor-dark">التوافق</th>
                                        <th class="p-4 text-center font-semibold text-blackColor dark:text-blackColor-dark">التكلفة</th>
                                        <th class="p-4 text-center font-semibold text-blackColor dark:text-blackColor-dark">الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rec in Model.RecentRecommendations)
                                    {
                                        <tr class="border-b border-borderColor dark:border-borderColor-dark hover:bg-lightGrey5/50 dark:hover:bg-whiteColor-dark/50 transition-colors">
                                            <td class="p-4">
                                                <a asp-controller="Recommendations" asp-action="Details" asp-route-id="@rec.Id" class="text-blackColor dark:text-blackColor-dark hover:text-primaryColor font-medium">
                                                    @rec.ProgramName
                                                </a>
                                            </td>
                                            <td class="p-4 text-contentColor dark:text-contentColor-dark">@rec.UniversityName</td>
                                            <td class="p-4 text-center">
                                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium @(rec.Score >= 80 ? "bg-greenColor/10 text-greenColor" : rec.Score >= 60 ? "bg-warning/10 text-warning" : "bg-danger/10 text-danger")">
                                                    @rec.Score.ToString("F0")%
                                                </span>
                                            </td>
                                            <td class="p-4 text-center text-contentColor dark:text-contentColor-dark">
                                                @rec.EstimatedCost.ToString("N0") د.أ
                                            </td>
                                            <td class="p-4 text-center">
                                                @if (rec.IsViewed)
                                                {
                                                    <span class="text-contentColor dark:text-contentColor-dark text-xs">
                                                        <i class="icofont-eye"></i> تمت المشاهدة
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-primaryColor/10 text-primaryColor">
                                                        جديد
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-10">
                            <i class="icofont-light-bulb text-5xl text-contentColor/30 mb-4"></i>
                            <h4 class="text-lg font-semibold text-blackColor dark:text-blackColor-dark mb-2">لا توجد توصيات بعد</h4>
                            <p class="text-contentColor dark:text-contentColor-dark mb-4">أكمل ملفك الشخصي للحصول على توصيات مخصصة</p>
                            <a asp-controller="Recommendations" asp-action="Generate" class="btn-primary">
                                احصل على توصيات <i class="icofont-arrow-left mr-1"></i>
                            </a>
                        </div>
                    }
                </div>

                <!-- Two Column Section: Applications & Notifications -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-30px">
                    <!-- Recent Applications -->
                    <div class="p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg">
                        <div class="flex justify-between items-center mb-6 pb-5 border-b-2 border-borderColor dark:border-borderColor-dark">
                            <h2 class="text-lg font-bold text-blackColor dark:text-blackColor-dark">
                                <i class="icofont-file-document text-secondaryColor ml-2"></i>
                                طلباتي الأخيرة
                            </h2>
                            <a asp-controller="Applications" asp-action="Index" class="text-primaryColor hover:text-secondaryColor text-sm">
                                عرض الكل <i class="icofont-arrow-left"></i>
                            </a>
                        </div>

                        @if (Model.RecentApplications.Any())
                        {
                            <div class="space-y-4">
                                @foreach (var app in Model.RecentApplications)
                                {
                                    <div class="flex items-center gap-4 p-4 bg-lightGrey5/50 dark:bg-whiteColor-dark/50 rounded-lg hover:bg-lightGrey5 dark:hover:bg-whiteColor-dark transition-colors">
                                        <div class="flex-1">
                                            <h6 class="font-medium text-blackColor dark:text-blackColor-dark mb-1">@app.ProgramName</h6>
                                            <p class="text-xs text-contentColor dark:text-contentColor-dark">@app.UniversityName</p>
                                            <p class="text-xs text-contentColor/70 dark:text-contentColor-dark/70 mt-1">
                                                <i class="icofont-calendar"></i> @app.ApplicationDate.ToString("dd/MM/yyyy")
                                            </p>
                                        </div>
                                        <span class="px-3 py-1 rounded-full text-xs font-medium text-white @app.StatusBadgeClass">
                                            @app.Status
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8">
                                <i class="icofont-file-document text-4xl text-contentColor/30 mb-3"></i>
                                <p class="text-contentColor dark:text-contentColor-dark">لا توجد طلبات بعد</p>
                            </div>
                        }
                    </div>

                    <!-- Recent Notifications -->
                    <div class="p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg">
                        <div class="flex justify-between items-center mb-6 pb-5 border-b-2 border-borderColor dark:border-borderColor-dark">
                            <h2 class="text-lg font-bold text-blackColor dark:text-blackColor-dark">
                                <i class="icofont-bell text-warning ml-2"></i>
                                الإشعارات
                            </h2>
                            <a asp-controller="Notifications" asp-action="Index" class="text-primaryColor hover:text-secondaryColor text-sm">
                                عرض الكل <i class="icofont-arrow-left"></i>
                            </a>
                        </div>

                        @if (Model.RecentNotifications.Any())
                        {
                            <div class="space-y-3">
                                @foreach (var notification in Model.RecentNotifications)
                                {
                                    <div class="flex gap-3 p-3 rounded-lg @(notification.IsRead ? "bg-transparent" : "bg-primaryColor/5") hover:bg-lightGrey5/50 dark:hover:bg-whiteColor-dark/50 transition-colors">
                                        <div class="w-10 h-10 rounded-full bg-primaryColor/10 flex items-center justify-center flex-shrink-0">
                                            <i class="icofont-bell text-primaryColor"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h6 class="font-medium text-blackColor dark:text-blackColor-dark text-sm truncate">@notification.Title</h6>
                                            <p class="text-xs text-contentColor dark:text-contentColor-dark line-clamp-2">@notification.Message</p>
                                            <p class="text-xs text-contentColor/70 dark:text-contentColor-dark/70 mt-1">
                                                @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                            </p>
                                        </div>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="w-2 h-2 rounded-full bg-primaryColor flex-shrink-0 mt-2"></span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8">
                                <i class="icofont-bell text-4xl text-contentColor/30 mb-3"></i>
                                <p class="text-contentColor dark:text-contentColor-dark">لا توجد إشعارات</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Quick Info Card -->
                <div class="mt-30px p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg">
                    <h2 class="text-lg font-bold text-blackColor dark:text-blackColor-dark mb-4">
                        <i class="icofont-info-circle text-primaryColor ml-2"></i>
                        معلوماتك السريعة
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div class="p-4 bg-lightGrey5/50 dark:bg-whiteColor-dark/50 rounded-lg">
                            <p class="text-sm text-contentColor dark:text-contentColor-dark mb-1">الميزانية</p>
                            <p class="text-lg font-bold text-blackColor dark:text-blackColor-dark">@Model.RegistrationBudget.ToString("N0") د.أ</p>
                        </div>
                        <div class="p-4 bg-lightGrey5/50 dark:bg-whiteColor-dark/50 rounded-lg">
                            <p class="text-sm text-contentColor dark:text-contentColor-dark mb-1">المعدل</p>
                            <p class="text-lg font-bold text-blackColor dark:text-blackColor-dark">@Model.GPA%</p>
                        </div>
                        <div class="p-4 bg-lightGrey5/50 dark:bg-whiteColor-dark/50 rounded-lg">
                            <p class="text-sm text-contentColor dark:text-contentColor-dark mb-1">المسار</p>
                            <p class="text-lg font-bold text-blackColor dark:text-blackColor-dark">@Model.PathDisplay</p>
                        </div>
                        <div class="p-4 bg-lightGrey5/50 dark:bg-whiteColor-dark/50 rounded-lg">
                            <p class="text-sm text-contentColor dark:text-contentColor-dark mb-1">عضو منذ</p>
                            <p class="text-lg font-bold text-blackColor dark:text-blackColor-dark">@Model.MemberSince.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Mark notifications as read when viewed
        document.querySelectorAll('[data-notification-id]').forEach(el => {
            el.addEventListener('click', function() {
                const id = this.dataset.notificationId;
                fetch(`/api/notifications/${id}/mark-read`, { method: 'POST' });
            });
        });
    </script>
}
