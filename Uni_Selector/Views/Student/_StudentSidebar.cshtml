@* Student Sidebar Navigation Partial *@
@* Usage: @@await Html.PartialAsync("_StudentSidebar", "ActivePage") *@
@{
    var activePage = Model as string ?? "Dashboard";
}

<div class="p-30px bg-whiteColor dark:bg-whiteColor-dark shadow-accordion dark:shadow-accordion-dark rounded-lg sticky top-20">
    <!-- User Greeting -->
    <h5 class="text-sm leading-1 font-semibold uppercase text-contentColor dark:text-contentColor-dark bg-lightGrey5 dark:bg-whiteColor-dark p-10px pb-7px mb-10px rounded">
        <i class="icofont-hand-right text-primaryColor ml-1"></i>
        مرحباً، @User.Identity?.Name
    </h5>

    <!-- Navigation Menu -->
    <ul>
        <!-- Dashboard -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark">
            <a asp-controller="Student" asp-action="Dashboard" 
               class="@(activePage == "Dashboard" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                لوحة التحكم
            </a>
        </li>

        <!-- My Profile -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark">
            <a asp-controller="Student" asp-action="Details" asp-route-id="0"
               class="@(activePage == "Profile" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                الملف الشخصي
            </a>
        </li>

        <!-- Recommendations -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark">
            <a asp-controller="Recommendations" asp-action="Index"
               class="@(activePage == "Recommendations" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-star">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                التوصيات
            </a>
        </li>

        <!-- Applications -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark flex justify-between items-center">
            <a asp-controller="Applications" asp-action="Index"
               class="@(activePage == "Applications" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-text">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                طلباتي
            </a>
            <span class="text-size-10 font-medium text-whiteColor px-9px bg-primaryColor leading-14px rounded-2xl pending-applications-badge">0</span>
        </li>

        <!-- Discounts -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark">
            <a asp-controller="Discounts" asp-action="Index"
               class="@(activePage == "Discounts" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-tag">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                </svg>
                خصوماتي
            </a>
        </li>

        <!-- Notifications -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark flex justify-between items-center">
            <a asp-controller="Notifications" asp-action="Index"
               class="@(activePage == "Notifications" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-bell">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                الإشعارات
            </a>
            <span class="text-size-10 font-medium text-whiteColor px-9px bg-secondaryColor leading-14px rounded-2xl unread-notifications-badge">0</span>
        </li>

        <!-- Universities Browser -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark">
            <a asp-controller="Universities" asp-action="Index"
               class="@(activePage == "Universities" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-book">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                تصفح الجامعات
            </a>
        </li>

        <!-- Programs Browser -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark">
            <a asp-controller="Programs" asp-action="Index"
               class="@(activePage == "Programs" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-layers">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                    <polyline points="2 17 12 22 22 17"></polyline>
                    <polyline points="2 12 12 17 22 12"></polyline>
                </svg>
                البرامج الأكاديمية
            </a>
        </li>

        <!-- Settings -->
        <li class="py-10px border-b border-borderColor dark:border-borderColor-dark">
            <a asp-controller="Student" asp-action="EditProfile"
               class="@(activePage == "Settings" ? "text-primaryColor" : "text-contentColor dark:text-contentColor-dark") hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-settings">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                الإعدادات
            </a>
        </li>

        <!-- Logout -->
        <li class="py-10px">
            <form asp-controller="Account" asp-action="Logout" method="post" class="w-full">
                <button type="submit" class="text-contentColor dark:text-contentColor-dark hover:text-primaryColor leading-1.8 flex gap-3 text-nowrap items-center w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-log-out">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    تسجيل الخروج
                </button>
            </form>
        </li>
    </ul>
</div>
