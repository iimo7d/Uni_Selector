@using Uni_Selector.Models.Enums
@using Uni_Selector.ViewModels.Students
@model CompleteProfileViewModel

@{
    ViewData["Title"] = "Complete Your Profile";
}

@section Styles {
    <style>
        .wizard-steps {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
            position: relative;
        }

            .wizard-steps::before {
                content: '';
                position: absolute;
                top: 20px;
                left: 0;
                right: 0;
                height: 2px;
                background: #e5e7eb;
                z-index: 0;
            }

        .wizard-step {
            flex: 1;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .wizard-step-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e5e7eb;
            color: #6b7280;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            margin-bottom: 10px;
            transition: all 0.3s;
        }

        .wizard-step.active .wizard-step-circle {
            background: #3b82f6;
            color: white;
        }

        .wizard-step.completed .wizard-step-circle {
            background: #10b981;
            color: white;
        }

        .wizard-content {
            display: none;
        }

            .wizard-content.active {
                display: block;
            }

        .required-asterisk {
            color: #ef4444;
            margin-left: 3px;
        }
    </style>
}

<!-- Breadcrumb -->
<section class="bg-whiteColor dark:bg-whiteColor-dark py-30px">
    <div class="container 3xl:container-secondary-lg 4xl:container mx-auto">
        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-bold text-blackColor dark:text-blackColor-dark">
                Complete Your Profile
            </h2>
            <ul class="flex gap-1 text-sm text-contentColor dark:text-contentColor-dark">
                <li><a asp-action="Index" asp-controller="Dashboard" class="hover:text-primaryColor">Dashboard</a></li>
                <li>/</li>
                <li>Complete Profile</li>
            </ul>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="py-50px">
    <div class="container 3xl:container-secondary-lg 4xl:container mx-auto">
        <div class="bg-whiteColor dark:bg-whiteColor-dark shadow-md rounded-lg p-30px">

            <!-- Progress Steps -->
            <div class="wizard-steps">
                <div class="wizard-step active" data-step="1">
                    <div class="wizard-step-circle">1</div>
                    <div class="text-sm font-medium">Personal Info</div>
                </div>
                <div class="wizard-step" data-step="2">
                    <div class="wizard-step-circle">2</div>
                    <div class="text-sm font-medium">Location</div>
                </div>
                <div class="wizard-step" data-step="3">
                    <div class="wizard-step-circle">3</div>
                    <div class="text-sm font-medium">Academic</div>
                </div>
                <div class="wizard-step" data-step="4">
                    <div class="wizard-step-circle">4</div>
                    <div class="text-sm font-medium">Preferences</div>
                </div>
                <div class="wizard-step" data-step="5">
                    <div class="wizard-step-circle">5</div>
                    <div class="text-sm font-medium">Special Info</div>
                </div>
            </div>

            <form asp-action="CompleteProfile" method="post" enctype="multipart/form-data" id="profileForm">
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>

                <!-- Step 1: Personal Information -->
                <div class="wizard-content active" data-step="1">
                    <h3 class="text-xl font-semibold text-blackColor dark:text-blackColor-dark mb-4">
                        Personal Information
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <!-- Display Only Fields -->
                        <div>
                            <label class="block mb-2 font-medium">Full Name</label>
                            <input type="text" value="@Model.FullName" disabled class="w-full py-2 px-4 bg-gray-100 border border-borderColor dark:border-borderColor-dark rounded-md" />
                        </div>
                        <div>
                            <label class="block mb-2 font-medium">Email</label>
                            <input type="text" value="@Model.Email" disabled class="w-full py-2 px-4 bg-gray-100 border border-borderColor dark:border-borderColor-dark rounded-md" />
                        </div>
                        <div>
                            <label class="block mb-2 font-medium">Phone Number</label>
                            <input type="text" value="@Model.PhoneNumber" disabled class="w-full py-2 px-4 bg-gray-100 border border-borderColor dark:border-borderColor-dark rounded-md" />
                        </div>

                        <!-- Editable Fields -->
                        <div>
                            <label asp-for="NationalId" class="block mb-2 font-medium">
                                <span asp-for="NationalId"></span><span class="required-asterisk">*</span>
                            </label>
                            <input asp-for="NationalId" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter 10-digit National ID" />
                            <span asp-validation-for="NationalId" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="SeatNumber" class="block mb-2 font-medium">
                                <span asp-for="SeatNumber"></span><span class="required-asterisk">*</span>
                            </label>
                            <input asp-for="SeatNumber" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter Tawjihi Seat Number" />
                            <span asp-validation-for="SeatNumber" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="Gender" class="block mb-2 font-medium">
                                <span asp-for="Gender"></span><span class="required-asterisk">*</span>
                            </label>
                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor">
                                <option value="">-- Select Gender --</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="DateOfBirth" class="block mb-2 font-medium">
                                <span asp-for="DateOfBirth"></span><span class="required-asterisk">*</span>
                            </label>
                            <input asp-for="DateOfBirth" type="date" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" />
                            <span asp-validation-for="DateOfBirth" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="Nationality" class="block mb-2 font-medium">
                                <span asp-for="Nationality"></span>
                            </label>
                            <input asp-for="Nationality" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" value="Jordanian" />
                            <span asp-validation-for="Nationality" class="text-red-500 text-sm"></span>
                        </div>

                        <!-- Guardian Information -->
                        <div class="md:col-span-2">
                            <h4 class="text-lg font-semibold text-blackColor dark:text-blackColor-dark mt-4 mb-2">Guardian Information</h4>
                        </div>

                        <div>
                            <label asp-for="GuardianName" class="block mb-2 font-medium">
                                <span asp-for="GuardianName"></span><span class="required-asterisk">*</span>
                            </label>
                            <input asp-for="GuardianName" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter guardian's full name" />
                            <span asp-validation-for="GuardianName" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="GuardianPhone" class="block mb-2 font-medium">
                                <span asp-for="GuardianPhone"></span><span class="required-asterisk">*</span>
                            </label>
                            <input asp-for="GuardianPhone" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter guardian's phone number" />
                            <span asp-validation-for="GuardianPhone" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="GuardianRelation" class="block mb-2 font-medium">
                                <span asp-for="GuardianRelation"></span><span class="required-asterisk">*</span>
                            </label>
                            <select asp-for="GuardianRelation" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor">
                                <option value="">-- Select Relation --</option>
                                @foreach (var relation in ViewBag.GuardianRelations as List<string>)
                                {
                                    <option value="@relation">@relation</option>
                                }
                            </select>
                            <span asp-validation-for="GuardianRelation" class="text-red-500 text-sm"></span>
                        </div>
                    </div>

                    <div class="flex justify-end gap-2 mt-6">
                        <button type="button" class="next-btn px-6 py-2 bg-primaryColor text-white rounded-md hover:bg-opacity-90">
                            Next <i class="icofont-rounded-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Step 2: Location Information -->
                <div class="wizard-content" data-step="2">
                    <h3 class="text-xl font-semibold text-blackColor dark:text-blackColor-dark mb-4">
                        Location Information
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label asp-for="Province" class="block mb-2 font-medium">
                                <span asp-for="Province"></span><span class="required-asterisk">*</span>
                            </label>
                            <select asp-for="Province" id="provinceSelect" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor">
                                <option value="">-- Select Province --</option>
                                @foreach (var province in ViewBag.Provinces as List<string>)
                                {
                                    <option value="@province">@province</option>
                                }
                            </select>
                            <span asp-validation-for="Province" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="City" class="block mb-2 font-medium">
                                <span asp-for="City"></span><span class="required-asterisk">*</span>
                            </label>
                            <input asp-for="City" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter your city" />
                            <span asp-validation-for="City" class="text-red-500 text-sm"></span>
                        </div>

                        <div class="md:col-span-2">
                            <label asp-for="Area" class="block mb-2 font-medium">
                                <span asp-for="Area"></span>
                            </label>
                            <input asp-for="Area" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter area or neighborhood (optional)" />
                            <span asp-validation-for="Area" class="text-red-500 text-sm"></span>
                        </div>
                    </div>

                    <div class="flex justify-between gap-2 mt-6">
                        <button type="button" class="prev-btn px-6 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
                            <i class="icofont-rounded-left"></i> Previous
                        </button>
                        <button type="button" class="next-btn px-6 py-2 bg-primaryColor text-white rounded-md hover:bg-opacity-90">
                            Next <i class="icofont-rounded-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Step 3: Academic Information -->
                <div class="wizard-content" data-step="3">
                    <h3 class="text-xl font-semibold text-blackColor dark:text-blackColor-dark mb-4">
                        Academic Information
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label asp-for="GPA" class="block mb-2 font-medium">
                                <span asp-for="GPA"></span><span class="required-asterisk">*</span>
                            </label>
                            <input asp-for="GPA" type="number" step="0.01" min="0" max="100" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter your GPA (0-100)" />
                            <span asp-validation-for="GPA" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="Path" class="block mb-2 font-medium">
                                <span asp-for="Path"></span><span class="required-asterisk">*</span>
                            </label>
                            <select asp-for="Path" id="pathSelect" asp-items="Html.GetEnumSelectList<PathType>()" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor">
                                <option value="">-- Select Educational Path --</option>
                            </select>
                            <span asp-validation-for="Path" class="text-red-500 text-sm"></span>
                        </div>

                        <div id="academicTrackDiv" style="display:none;">
                            <label asp-for="AcademicTrack" class="block mb-2 font-medium">
                                <span asp-for="AcademicTrack"></span>
                            </label>
                            <select asp-for="AcademicTrack" asp-items="Html.GetEnumSelectList<AcademicTrack>()" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor">
                                <option value="">-- Select Academic Track --</option>
                            </select>
                            <span asp-validation-for="AcademicTrack" class="text-red-500 text-sm"></span>
                        </div>

                        <div id="vocationalBranchDiv" style="display:none;">
                            <label asp-for="VocationalBranch" class="block mb-2 font-medium">
                                <span asp-for="VocationalBranch"></span>
                            </label>
                            <select asp-for="VocationalBranch" asp-items="Html.GetEnumSelectList<VocationalBranch>()" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor">
                                <option value="">-- Select Vocational Branch --</option>
                            </select>
                            <span asp-validation-for="VocationalBranch" class="text-red-500 text-sm"></span>
                        </div>

                        <div id="btecDiv" style="display:none;" class="md:col-span-2">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="flex items-center">
                                    <input asp-for="BtecLevel2Completed" type="checkbox" class="mr-2" />
                                    <label asp-for="BtecLevel2Completed" class="font-medium">BTEC Level 2 Completed</label>
                                </div>

                                <div class="flex items-center">
                                    <input asp-for="BtecLevel3Completed" type="checkbox" class="mr-2" />
                                    <label asp-for="BtecLevel3Completed" class="font-medium">BTEC Level 3 Completed</label>
                                </div>

                                <div class="md:col-span-2">
                                    <label asp-for="BtecCertificateFile" class="block mb-2 font-medium">
                                        Upload BTEC Certificate (PDF or Image)
                                    </label>
                                    <input asp-for="BtecCertificateFile" type="file" accept=".pdf,.jpg,.jpeg,.png" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md" />
                                    <span asp-validation-for="BtecCertificateFile" class="text-red-500 text-sm"></span>
                                    <small class="text-gray-500">Accepted formats: PDF, JPG, PNG (Max 5MB)</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-between gap-2 mt-6">
                        <button type="button" class="prev-btn px-6 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
                            <i class="icofont-rounded-left"></i> Previous
                        </button>
                        <button type="button" class="next-btn px-6 py-2 bg-primaryColor text-white rounded-md hover:bg-opacity-90">
                            Next <i class="icofont-rounded-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Step 4: Preferences -->
                <div class="wizard-content" data-step="4">
                    <h3 class="text-xl font-semibold text-blackColor dark:text-blackColor-dark mb-4">
                        University Preferences
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label asp-for="RegistrationBudget" class="block mb-2 font-medium">
                                <span asp-for="RegistrationBudget"></span><span class="required-asterisk">*</span>
                            </label>
                            <input asp-for="RegistrationBudget" type="number" step="0.01" min="0" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter your budget in JOD" />
                            <span asp-validation-for="RegistrationBudget" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="PreferredCity" class="block mb-2 font-medium">
                                <span asp-for="PreferredCity"></span>
                            </label>
                            <input asp-for="PreferredCity" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Preferred university city (optional)" />
                            <span asp-validation-for="PreferredCity" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="MaxDistanceKm" class="block mb-2 font-medium">
                                <span asp-for="MaxDistanceKm"></span>
                            </label>
                            <input asp-for="MaxDistanceKm" type="number" min="1" max="200" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" value="50" />
                            <span asp-validation-for="MaxDistanceKm" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="PreferredLanguage" class="block mb-2 font-medium">
                                <span asp-for="PreferredLanguage"></span>
                            </label>
                            <select asp-for="PreferredLanguage" asp-items="Html.GetEnumSelectList<LanguageCode>()" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor">
                            </select>
                            <span asp-validation-for="PreferredLanguage" class="text-red-500 text-sm"></span>
                        </div>

                        <div class="md:col-span-2">
                            <label asp-for="DesiredMajors" class="block mb-2 font-medium">
                                <span asp-for="DesiredMajors"></span>
                            </label>
                            <input asp-for="DesiredMajors" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Enter desired majors separated by commas (e.g., Computer Science, Engineering, Medicine)" />
                            <span asp-validation-for="DesiredMajors" class="text-red-500 text-sm"></span>
                            <small class="text-gray-500">Separate multiple majors with commas</small>
                        </div>
                    </div>

                    <div class="flex justify-between gap-2 mt-6">
                        <button type="button" class="prev-btn px-6 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
                            <i class="icofont-rounded-left"></i> Previous
                        </button>
                        <button type="button" class="next-btn px-6 py-2 bg-primaryColor text-white rounded-md hover:bg-opacity-90">
                            Next <i class="icofont-rounded-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Step 5: Special Circumstances -->
                <div class="wizard-content" data-step="5">
                    <h3 class="text-xl font-semibold text-blackColor dark:text-blackColor-dark mb-4">
                        Special Circumstances & Additional Information
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div class="flex items-center">
                            <input asp-for="HasDisability" type="checkbox" id="hasDisabilityCheck" class="mr-2" />
                            <label asp-for="HasDisability" class="font-medium">I have a disability</label>
                        </div>

                        <div id="disabilityTypeDiv" style="display:none;">
                            <label asp-for="DisabilityType" class="block mb-2 font-medium">
                                <span asp-for="DisabilityType"></span>
                            </label>
                            <input asp-for="DisabilityType" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor" placeholder="Specify disability type" />
                            <span asp-validation-for="DisabilityType" class="text-red-500 text-sm"></span>
                        </div>

                        <div class="flex items-center">
                            <input asp-for="IsOrphan" type="checkbox" class="mr-2" />
                            <label asp-for="IsOrphan" class="font-medium">I am an orphan</label>
                        </div>

                        <div class="flex items-center">
                            <input asp-for="IsEmployeeChild" type="checkbox" class="mr-2" />
                            <label asp-for="IsEmployeeChild" class="font-medium">I am a university employee's child</label>
                        </div>

                        <div class="flex items-center">
                            <input asp-for="HasFamilyConnection" type="checkbox" id="hasFamilyConnectionCheck" class="mr-2" />
                            <label asp-for="HasFamilyConnection" class="font-medium">I have family working at a university</label>
                        </div>

                        <div id="familyUniversityDiv" style="display:none;">
                            <label asp-for="FamilyConnectionUniversityId" class="block mb-2 font-medium">
                                <span asp-for="FamilyConnectionUniversityId"></span>
                            </label>
                            <select asp-for="FamilyConnectionUniversityId" class="w-full py-2 px-4 border border-borderColor dark:border-borderColor-dark rounded-md focus:outline-none focus:ring-2 focus:ring-primaryColor">
                                <option value="">-- Select University --</option>
                                @foreach (var university in ViewBag.Universities as List<SelectListItem>)
                                {
                                    <option value="@university.Value">@university.Text</option>
                                }
                            </select>
                            <span asp-validation-for="FamilyConnectionUniversityId" class="text-red-500 text-sm"></span>
                        </div>
                    </div>

                    <div class="flex justify-between gap-2 mt-6">
                        <button type="button" class="prev-btn px-6 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400">
                            <i class="icofont-rounded-left"></i> Previous
                        </button>
                        <button type="submit" class="px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700">
                            <i class="icofont-check-circled"></i> Complete Profile
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            let currentStep = 1;
            const totalSteps = 5;

            // Wizard Navigation
            $('.next-btn').click(function() {
                if (currentStep < totalSteps) {
                    $(`.wizard-content[data-step="${currentStep}"]`).removeClass('active');
                    $(`.wizard-step[data-step="${currentStep}"]`).removeClass('active').addClass('completed');
                    currentStep++;
                    $(`.wizard-content[data-step="${currentStep}"]`).addClass('active');
                    $(`.wizard-step[data-step="${currentStep}"]`).addClass('active');
                    window.scrollTo(0, 0);
                }
            });

            $('.prev-btn').click(function() {
                if (currentStep > 1) {
                    $(`.wizard-content[data-step="${currentStep}"]`).removeClass('active');
                    $(`.wizard-step[data-step="${currentStep}"]`).removeClass('active');
                    currentStep--;
                    $(`.wizard-content[data-step="${currentStep}"]`).addClass('active');
                    $(`.wizard-step[data-step="${currentStep}"]`).removeClass('completed').addClass('active');
                    window.scrollTo(0, 0);
                }
            });

            // Path Type Change Handler
            $('#pathSelect').change(function() {
                const pathValue = $(this).val();
                $('#academicTrackDiv').hide();
                $('#vocationalBranchDiv').hide();
                $('#btecDiv').hide();

                if (pathValue == '1') { // Academic
                    $('#academicTrackDiv').show();
                } else if (pathValue == '2') { // Vocational
                    $('#vocationalBranchDiv').show();
                } else if (pathValue == '3') { // BTEC
                    $('#btecDiv').show();
                }
            });

            // Disability Checkbox Handler
            $('#hasDisabilityCheck').change(function() {
                if ($(this).is(':checked')) {
                    $('#disabilityTypeDiv').show();
                } else {
                    $('#disabilityTypeDiv').hide();
                    $('#DisabilityType').val('');
                }
            });

            // Family Connection Checkbox Handler
            $('#hasFamilyConnectionCheck').change(function() {
                if ($(this).is(':checked')) {
                    $('#familyUniversityDiv').show();
                } else {
                    $('#familyUniversityDiv').hide();
                    $('#FamilyConnectionUniversityId').val('');
                }
            });

            // Form Submission with SweetAlert
            $('#profileForm').submit(function(e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Complete Profile?',
                    text: "Are you sure all information is correct?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3b82f6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, complete!',
                    cancelButtonText: 'Review Again'
                }).then((result) => {
                    if (result.isConfirmed) {
                        this.submit();
                    }
                });
            });

            // Trigger path change on load if value exists
            if ($('#pathSelect').val()) {
                $('#pathSelect').trigger('change');
            }
        });
    </script>
}
