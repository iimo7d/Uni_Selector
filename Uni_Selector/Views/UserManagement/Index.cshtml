@model Uni_Selector.ViewModels.UserManagement.UserListPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
}

<!-- Breadcrumb -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
    <h6 class="fw-semibold mb-0">User Management</h6>
    <ul class="d-flex align-items-center gap-2">
        <li class="fw-medium">
            <a asp-action="Index" asp-controller="Dashboard" class="d-flex align-items-center gap-1 hover-text-primary">
                <iconify-icon icon="solar:home-smile-angle-outline" class="icon text-lg"></iconify-icon>
                Dashboard
            </a>
        </li>
        <li>-</li>
        <li class="fw-medium">Users</li>
    </ul>
</div>

<!-- Display Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                showConfirmButton: false,
                timer: 3000
            });
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: '@TempData["ErrorMessage"]',
                showConfirmButton: true
            });
        });
    </script>
}

<div class="card">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <h6 class="text-lg mb-0">All Users (@Model.TotalUsers)</h6>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <a asp-action="Export" class="btn btn-sm btn-outline-primary-600">
                <i class="ri-download-line"></i> Export Excel
            </a>
            <a asp-action="Create" class="btn btn-sm btn-primary-600">
                <i class="ri-add-line"></i> Add New User
            </a>
        </div>
    </div>

    <div class="card-body">
        <!-- Search and Filter Form -->
        <form asp-action="Index" method="get" class="row gy-3 mb-24">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <div class="icon-field">
                    <span class="icon">
                        <iconify-icon icon="ion:search-outline"></iconify-icon>
                    </span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, email or phone..." value="@Model.SearchTerm">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Role</label>
                <select name="roleFilter" class="form-select">
                    <option value="">All Roles</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role" selected="@(Model.RoleFilter == role)">@role</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="statusFilter" class="form-select">
                    <option value="">All Status</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Locked</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary-600 w-100">
                    <i class="ri-search-line"></i> Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="ri-refresh-line"></i> Reset
                </a>
            </div>
        </form>

        <!-- Users Table -->
        <div class="table-responsive">
            <table class="table bordered-table mb-0">
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Role</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created At</th>
                        <th scope="col">Last Login</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="w-40-px h-40-px rounded-circle flex-shrink-0 me-12 overflow-hidden bg-primary-100 d-flex align-items-center justify-content-center">
                                            <span class="text-primary-600 fw-semibold">@user.FullName.Substring(0, 1).ToUpper()</span>
                                        </div>
                                        <h6 class="text-md mb-0 fw-medium flex-grow-1">@user.FullName</h6>
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:@user.Email" class="text-primary-600">@user.Email</a>
                                </td>
                                <td>@(user.PhoneNumber ?? "N/A")</td>
                                <td>
                                    <span class="badge bg-primary-100 text-primary-600 px-12 py-4 rounded-pill fw-medium text-sm">@user.Roles</span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="bg-success-focus text-success-main px-24 py-4 rounded-pill fw-medium text-sm">Active</span>
                                    }
                                    else
                                    {
                                        <span class="bg-danger-focus text-danger-main px-24 py-4 rounded-pill fw-medium text-sm">Locked</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>@(user.LastLoginAt?.ToString("MMM dd, yyyy") ?? "Never")</td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary-600" title="View Details">
                                            <i class="ri-eye-line"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning-600" title="Edit User">
                                            <i class="ri-edit-line"></i>
                                        </a>
                                        @if (user.IsActive)
                                        {
                                            <form id="lockForm-@user.Id" method="post" asp-action="Lock" asp-route-id="@user.Id" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-danger-600" onclick="lockUser('@user.Id', '@user.FullName')" title="Lock User">
                                                <i class="ri-lock-line"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <form id="unlockForm-@user.Id" method="post" asp-action="Unlock" asp-route-id="@user.Id" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-success-600" onclick="unlockUser('@user.Id', '@user.FullName')" title="Unlock User">
                                                <i class="ri-lock-unlock-line"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center">
                                    <iconify-icon icon="solar:user-broken" class="text-primary-600" style="font-size: 48px;"></iconify-icon>
                                    <p class="mt-3 mb-0 text-secondary-light">No users found</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-24">
                <div>
                    <span class="text-sm text-secondary-light">
                        Showing @Model.StartRecord to @Model.EndRecord of @Model.TotalUsers users
                    </span>
                </div>
                <ul class="pagination d-flex flex-wrap align-items-center gap-2 justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link bg-neutral-300 text-secondary-light fw-semibold radius-8 border-0 d-flex align-items-center justify-content-center h-32-px w-32-px"
                               href="?page=@(Model.CurrentPage - 1)&searchTerm=@Model.SearchTerm&roleFilter=@Model.RoleFilter&statusFilter=@Model.StatusFilter">
                                <iconify-icon icon="ep:d-arrow-left"></iconify-icon>
                            </a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == 1 || i == Model.TotalPages || (i >= Model.CurrentPage - 1 && i <= Model.CurrentPage + 1))
                        {
                            <li class="page-item">
                                <a class="page-link fw-semibold radius-8 border-0 d-flex align-items-center justify-content-center h-32-px w-32-px @(i == Model.CurrentPage ? "bg-primary-600 text-white" : "bg-neutral-300 text-secondary-light")"
                                   href="?page=@i&searchTerm=@Model.SearchTerm&roleFilter=@Model.RoleFilter&statusFilter=@Model.StatusFilter">@i</a>
                            </li>
                        }
                        else if (i == Model.CurrentPage - 2 || i == Model.CurrentPage + 2)
                        {
                            <li class="page-item">
                                <span class="page-link bg-neutral-300 text-secondary-light fw-semibold radius-8 border-0 d-flex align-items-center justify-content-center h-32-px w-32-px">...</span>
                            </li>
                        }
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link bg-neutral-300 text-secondary-light fw-semibold radius-8 border-0 d-flex align-items-center justify-content-center h-32-px w-32-px"
                               href="?page=@(Model.CurrentPage + 1)&searchTerm=@Model.SearchTerm&roleFilter=@Model.RoleFilter&statusFilter=@Model.StatusFilter">
                                <iconify-icon icon="ep:d-arrow-right"></iconify-icon>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function lockUser(userId, userName) {
            Swal.fire({
                title: 'Lock User?',
                text: `Are you sure you want to lock ${userName}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, lock user!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('lockForm-' + userId);
                    form.submit();
                }
            });
        }

        function unlockUser(userId, userName) {
            Swal.fire({
                title: 'Unlock User?',
                text: `Are you sure you want to unlock ${userName}?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, unlock user!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.getElementById('unlockForm-' + userId);
                    form.submit();
                }
            });
        }
    </script>
}
